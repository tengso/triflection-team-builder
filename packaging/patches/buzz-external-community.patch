+#[cfg(test)]
+mod builder_external_tests {
+    use super::validate_external_repository_tags as validate;
+    fn tags() -> Vec<Vec<String>> {
+        vec![vec!["buzz-hosting", "external"], vec!["clone", "https://github.com/owner/repo.git"],
+             vec!["web", "https://github.com/owner/repo"]]
+            .into_iter().map(|t| t.into_iter().map(str::to_owned).collect()).collect()
+    }
+    #[test]
+    fn explicit_external_validates_and_stock_default_is_unchanged() {
+        assert_eq!(validate(&tags(), true), Ok(true));
+        assert_eq!(validate(&[], false), Ok(false));
+        assert!(validate(&[], true).is_err());
+    }
+    #[test]
+    fn malformed_markers_and_credentials_are_rejected() {
+        let mut duplicate = tags(); duplicate.push(duplicate[0].clone());
+        assert!(validate(&duplicate, true).is_err());
+        for bad in ["https://token@github.com/owner/repo.git", "https://github.com.evil/owner/repo.git",
+                    "http://github.com/owner/repo.git", "https://github.com/owner/repo.git?token=x",
+                    "https://github.com/owner/../repo.git"] {
+            let mut t = tags(); t[1][1] = bad.into();
+            assert!(validate(&t, true).is_err());
+        }
+    }
+}
