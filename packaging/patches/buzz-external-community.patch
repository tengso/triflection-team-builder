+/// Builder external-only metadata validation. Called before event storage.
+pub(crate) fn validate_external_repository_tags(
+    tags: &[Vec<String>], required: bool,
+) -> Result<bool, &'static str> {
+    let values = |name: &str| -> Vec<&Vec<String>> {
+        tags.iter().filter(|t| t.first().map(String::as_str) == Some(name)).collect()
+    };
+    let markers = values("buzz-hosting");
+    if markers.is_empty() {
+        return if required { Err("external repository marker required") } else { Ok(false) };
+    }
+    if markers.len() != 1 || markers[0].len() != 2 || markers[0][1] != "external" {
+        return Err("invalid or duplicate external repository marker");
+    }
+    let clones = values("clone");
+    let webs = values("web");
+    if clones.len() != 1 || clones[0].len() != 2 || webs.len() != 1 || webs[0].len() != 2 {
+        return Err("exactly one clone and web URL required");
+    }
+    let clone = &clones[0][1];
+    let web = clone.strip_suffix(".git").ok_or("clone URL must end in .git")?;
+    if webs[0][1] != web { return Err("clone and web URLs differ"); }
+    let path = web.strip_prefix("https://github.com/").ok_or("GitHub HTTPS URL required")?;
+    let parts: Vec<&str> = path.split('/').collect();
+    if parts.len() != 2 || parts.iter().any(|p| p.is_empty() || *p == "." || *p == ".."
+        || !p.bytes().all(|c| c.is_ascii_alphanumeric() || b"-_.".contains(&c))) {
+        return Err("invalid GitHub path or credential-bearing URL");
+    }
+    Ok(true)
+}
