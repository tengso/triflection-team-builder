+#[cfg(test)]
+mod internal_url_tests {
+    use super::*;
+
+    #[test]
+    fn only_explicit_internal_authority_aliases_the_deployment() {
+        let internal = "http://relay:3000";
+        let canonical = "ws://127.0.0.1:3400";
+        assert_eq!(
+            internal_community_host("relay:3000", internal, canonical),
+            Some("127.0.0.1:3400".to_string())
+        );
+        for unknown in ["", "relay:3400", "evil:3000", "127.0.0.1:3400"] {
+            assert_eq!(internal_community_host(unknown, internal, canonical), None);
+        }
+        for invalid in [
+            "",
+            "http://user:pass@relay:3000",
+            "http://relay:3000/path",
+            "ws://relay:3000",
+        ] {
+            assert_eq!(
+                internal_community_host("relay:3000", invalid, canonical),
+                None
+            );
+        }
+        assert_eq!(internal_community_host("relay:3000", internal, ""), None);
+    }
+}
