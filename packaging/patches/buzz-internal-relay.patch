 /// `buzz-admin` CLI derive a byte-identical authority (same port/IPv6 handling).
 pub use buzz_core::tenant::relay_url_authority;
 
+/// One explicitly configured internal authority may resolve to this deployment's
+/// existing community. Keep the request authority in TenantContext: NIP-98 and
+/// NIP-42 signatures must still match the exact HTTP/WebSocket connection host.
+fn internal_community_host(host: &str, internal_url: &str, relay_url: &str) -> Option<String> {
+    let internal = url::Url::parse(internal_url).ok()?;
+    if internal.scheme() != "http"
+        || internal.host_str().is_none()
+        || !internal.username().is_empty()
+        || internal.password().is_some()
+        || !matches!(internal.path(), "" | "/")
+        || internal.query().is_some()
+        || internal.fragment().is_some()
+    {
+        return None;
+    }
+    if host.is_empty() || host != relay_url_authority(internal_url) {
+        return None;
+    }
+    let canonical = relay_url_authority(relay_url);
+    if canonical.is_empty() || canonical == host {
+        return None;
+    }
+    Some(canonical)
+}
+
+/// Public links always use the client-facing authority, even on an internal
+/// authenticated request. Authentication itself still uses TenantContext.host.
+pub(crate) fn client_facing_host(host: &str, relay_url: &str) -> String {
+    let internal = std::env::var("BUZZ_INTERNAL_RELAY_URL").unwrap_or_default();
+    internal_community_host(host, &internal, relay_url).unwrap_or_else(|| host.to_string())
+}
